ARG BASE_IMAGE=ghcr.1ms.run/moumouhao12138-sketch/slime-worker:0.0.37-fixed
FROM ${BASE_IMAGE}

ARG INSTALL_CTF_REFERENCE_ASSETS=true
ARG DEEPSEEK_HARNESS_VERSION=0.1.0-rc.7

USER root

RUN if ! command -v dsh >/dev/null 2>&1; then \
        HOME=/root npm_config_cache=/root/.npm npm install -g \
            "@deepseek-ai/dsh@${DEEPSEEK_HARNESS_VERSION}"; \
    fi \
    && rm -rf /home/kali/.npm /root/.npm

COPY scripts/build_tool_manifest.py /usr/local/bin/build_tool_manifest.py
COPY scripts/patch_deepseek_harness.py /usr/local/bin/patch_deepseek_harness.py

RUN python3 /usr/local/bin/patch_deepseek_harness.py \
        "$(npm root -g)/@deepseek-ai/dsh/node_modules/@deepseek-ai/dsh-llm-deepseek"

RUN python3 /usr/local/bin/build_tool_manifest.py /tmp/dsh-tools.json \
    && jq -s '.[0] + [.[1][] | select(.name == "dsh")]' \
        /opt/slime-cairn/tools.json /tmp/dsh-tools.json \
        > /tmp/slime-tools.json \
    && install -m 0644 /tmp/slime-tools.json /opt/slime-cairn/tools.json \
    && rm -f /tmp/dsh-tools.json /tmp/slime-tools.json

RUN if [ "${INSTALL_CTF_REFERENCE_ASSETS}" = "true" ]; then \
        mkdir -p /home/kali/knowledges; \
        clone_sparse() { \
            url="$1"; destination="$2"; \
            if [ -d "$destination/.git" ]; then return 0; fi; \
            git clone --depth 1 --filter=blob:none --no-checkout --sparse "$url" "$destination"; \
            git -C "$destination" sparse-checkout set --no-cone \
                '*.md' '*.py' '*.c' '*.cc' '*.cpp' '*.h' '*.s' '*.asm' '*.sh' \
                '*.rb' '*.go' '*.rs' '*.java' '*.php' '*.txt' '*.adoc' '*.rst' \
                'LICENSE*' 'Dockerfile*' 'Makefile'; \
            git -C "$destination" checkout --quiet; \
        }; \
        clone_sparse https://github.com/ctf-wiki/ctf-wiki.git /home/kali/knowledges/CTF-Wiki; \
        clone_sparse https://github.com/ProbiusOfficial/Hello-CTF.git /home/kali/knowledges/Hello-CTF; \
        clone_sparse https://github.com/firmianay/CTF-All-In-One.git /home/kali/knowledges/CTF-All-In-One; \
        clone_sparse https://github.com/trailofbits/ctf.git /home/kali/knowledges/CTF-Field-Guide; \
        clone_sparse https://github.com/shellphish/how2heap.git /home/kali/knowledges/how2heap; \
        clone_sparse https://github.com/RPISEC/MBE.git /home/kali/knowledges/MBE; \
        clone_sparse https://github.com/jvdsn/crypto-attacks.git /home/kali/knowledges/crypto-attacks; \
        clone_sparse https://github.com/ljagiello/ctf-skills.git /home/kali/knowledges/ctf-skills; \
    fi \
    && for directory in \
        /home/kali/knowledges/CTF-Wiki \
        /home/kali/knowledges/Hello-CTF \
        /home/kali/knowledges/CTF-All-In-One \
        /home/kali/knowledges/CTF-Field-Guide \
        /home/kali/knowledges/how2heap \
        /home/kali/knowledges/MBE \
        /home/kali/knowledges/crypto-attacks \
        /home/kali/knowledges/ctf-skills; do \
        [ ! -d "$directory" ] \
            || [ "$(stat -c '%u:%g' "$directory")" = "1000:1000" ] \
            || chown -R 1000:1000 "$directory"; \
    done

COPY scripts/build_ctf_knowledge_manifest.py /usr/local/bin/build_ctf_knowledge_manifest.py

RUN python3 /usr/local/bin/build_ctf_knowledge_manifest.py /opt/slime-cairn/ctf-knowledge.json \
    && chown 1000:1000 /opt/slime-cairn/ctf-knowledge.json

USER kali
WORKDIR /workspace
ENTRYPOINT []
CMD ["sleep", "infinity"]
