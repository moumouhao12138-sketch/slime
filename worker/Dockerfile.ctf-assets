ARG BASE_IMAGE=ghcr.1ms.run/moumouhao12138-sketch/slime-worker:0.0.37-fixed
FROM ${BASE_IMAGE}

ARG INSTALL_CTF_REFERENCE_ASSETS=true

USER root

RUN if [ "${INSTALL_CTF_REFERENCE_ASSETS}" = "true" ]; then \
        mkdir -p /home/kali/knowledges; \
        git clone --depth 1 https://github.com/ctf-wiki/ctf-wiki.git /home/kali/knowledges/CTF-Wiki; \
        git clone --depth 1 https://github.com/ProbiusOfficial/Hello-CTF.git /home/kali/knowledges/Hello-CTF; \
        git clone --depth 1 https://github.com/firmianay/CTF-All-In-One.git /home/kali/knowledges/CTF-All-In-One; \
        git clone --depth 1 https://github.com/trailofbits/ctf.git /home/kali/knowledges/CTF-Field-Guide; \
        git clone --depth 1 https://github.com/shellphish/how2heap.git /home/kali/knowledges/how2heap; \
        git clone --depth 1 https://github.com/RPISEC/MBE.git /home/kali/knowledges/MBE; \
        git clone --depth 1 https://github.com/jvdsn/crypto-attacks.git /home/kali/knowledges/crypto-attacks; \
        git clone --depth 1 https://github.com/ljagiello/ctf-skills.git /home/kali/knowledges/ctf-skills; \
    fi \
    && chown -R 1000:1000 /home/kali/knowledges

COPY scripts/build_ctf_knowledge_manifest.py /usr/local/bin/build_ctf_knowledge_manifest.py

RUN python3 /usr/local/bin/build_ctf_knowledge_manifest.py /opt/slime-cairn/ctf-knowledge.json \
    && chown 1000:1000 /opt/slime-cairn/ctf-knowledge.json

USER kali
WORKDIR /workspace
ENTRYPOINT []
CMD ["sleep", "infinity"]
