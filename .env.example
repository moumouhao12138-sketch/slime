# Shared provider fallback used when an adapter-specific value is empty.
SLIME_LLM_BASE_URL=https://api.example.com/v1
SLIME_LLM_API_KEY=replace-with-a-low-privilege-key
SLIME_LLM_MODEL=replace-with-model-name

# Codex Worker: Responses API.
SLIME_CODEX_BASE_URL=https://api.example.com/v1
SLIME_CODEX_API_KEY=replace-with-a-low-privilege-key
SLIME_CODEX_MODEL=replace-with-model-name
SLIME_CODEX_REASONING_EFFORT=xhigh

# Pi Worker: Chat Completions API. Empty values use the shared fallback.
SLIME_PI_BASE_URL=
SLIME_PI_API_KEY=
SLIME_PI_MODEL=

# Optional Claude Worker: Anthropic Messages API.
SLIME_CLAUDE_BASE_URL=https://api.example.com
SLIME_CLAUDE_API_KEY=
SLIME_CLAUDE_MODEL=

# Local state and dispatch paths.
SLIME_CAIRN_DB=slime-cairn.db
SLIME_DISPATCH_CONFIG=
SLIME_WORKSPACES_ROOT=slime-workspaces

# Concurrency and scheduling.
SLIME_MAX_WORKERS=8
SLIME_MAX_RUNNING_PROJECTS=3
SLIME_MAX_PROJECT_WORKERS=4
SLIME_RUNTIME_INTERVAL=3
SLIME_HEARTBEAT_INTERVAL=3
SLIME_STATE_HEARTBEAT_INTERVAL=2
SLIME_PROJECT_DISCOVERY_INTERVAL=0.25
SLIME_DISPATCHER_STALE_AFTER=10

# Slime branch selection.
SLIME_GROWTH_SELECTION_MODE=sma_discrete
SLIME_GROWTH_EXPLORATION_PROBABILITY=0.12
SLIME_GROWTH_EXPLORATION_MIN_PROBABILITY=0.03
SLIME_GROWTH_CONVERGENCE_SELECTIONS=24
SLIME_GROWTH_RANDOM_SEED=slime-sma-v1

# Lease and task timeouts.
SLIME_LEASE_SECONDS=15
SLIME_REASON_LEASE_SECONDS=15
SLIME_BOOTSTRAP_TIMEOUT=300
SLIME_BOOTSTRAP_CONCLUDE_TIMEOUT=90
SLIME_REASON_TIMEOUT=300
SLIME_REASON_MAX_INTENTS=2
SLIME_EXPLORE_TIMEOUT=300
SLIME_EXPLORE_CONCLUDE_TIMEOUT=90
SLIME_REASON_BATCH_SIZE=2
SLIME_REASON_DEBOUNCE=1

# Retry and cooldown policy. Set MAX_INTENT_ATTEMPTS=0 only for an unbounded queue.
SLIME_MAX_INTENT_ATTEMPTS=6
SLIME_INTENT_FAILURE_BACKOFF_SECONDS=30
SLIME_INTENT_FAILURE_BACKOFF_MAX_SECONDS=1800
SLIME_WORKER_REJECTED_COOLDOWN=5
SLIME_INTENT_WORKER_CYCLE_COOLDOWN=30
SLIME_REASON_FAILURE_COOLDOWN=5
SLIME_REASON_FAILURE_BACKOFF_MAX=5
SLIME_REASON_FAILURE_PAUSE_THRESHOLD=3
SLIME_REASON_FAILURE_PAUSE_SECONDS=60
SLIME_REASON_FAILURE_PAUSE_MAX_SECONDS=300

# Container runtime.
SLIME_RUNTIME_MODE=docker
SLIME_RUNTIME_EXECUTION=container
SLIME_WORKER_BASE_IMAGE=docker.1ms.run/kalilinux/kali-rolling
SLIME_KALI_APT_MIRROR=https://mirrors.ustc.edu.cn/kali/
SLIME_KALI_APT_VERIFY_PEER=false
SLIME_INSTALL_NATIVE_AGENTS=true
SLIME_INSTALL_REFERENCE_ASSETS=false
SLIME_WORKER_HEALTHCHECK=startup_only
SLIME_HEALTHCHECK_TIMEOUT=60
SLIME_WORKER_PROFILE=standard
SLIME_DOCKER_BINARY=docker
SLIME_LAB_NETWORK=slime-cairn-lab
SLIME_STOP_WORKERS_ON_EXIT=0

# Benchmark control plane. The token is never copied into Worker prompts.
BENCHMARK_BASE_URL=
BENCHMARK_TOKEN=
BENCHMARK_TIMEOUT=30
BENCHMARK_AUTOMATION_INTERVAL=3
