# Shared gateway settings used by DeepSeek Harness and the optional Codex Worker.
SLIME_CODEX_BASE_URL=https://api.example.com/v1
SLIME_CODEX_API_KEY=replace-with-api-key
SLIME_CODEX_MODEL=replace-with-model-name
SLIME_CODEX_REASONING_EFFORT=xhigh

# Optional dedicated competition Writeup Worker. It defaults to the Codex
# model settings above and is queued only after a project is completed.
SLIME_WRITEUP_BASE_URL=
SLIME_WRITEUP_API_KEY=
SLIME_WRITEUP_MODEL=
SLIME_WRITEUP_PROTOCOL=openai-responses
SLIME_WRITEUP_FULL_ENDPOINT=
SLIME_WRITEUP_TIMEOUT=300
SLIME_WRITEUP_RETRIES=3
SLIME_WRITEUP_RETRY_SECONDS=10
SLIME_WRITEUP_MAX_OUTPUT_TOKENS=32000
SLIME_WRITEUP_REASONING_EFFORT=low

# Optional shared fallback for any Worker with empty adapter-specific values.
SLIME_LLM_BASE_URL=
SLIME_LLM_API_KEY=
SLIME_LLM_MODEL=

# Optional Pi Worker. Enable it in dispatch.json before use.
SLIME_PI_BASE_URL=
SLIME_PI_API_KEY=
SLIME_PI_MODEL=

# Optional Claude Worker. Enable it in dispatch.json before use.
SLIME_CLAUDE_BASE_URL=
SLIME_CLAUDE_API_KEY=
SLIME_CLAUDE_MODEL=

# DeepSeek Harness native Worker. Empty values reuse the Codex settings above.
SLIME_DEEPSEEK_BASE_URL=
SLIME_DEEPSEEK_API_KEY=
SLIME_DEEPSEEK_MODEL=

# Compose deployment. Published images are used by default.
SLIME_APP_IMAGE=ghcr.io/moumouhao12138-sketch/slime:0.0.40
SLIME_WORKER_IMAGE=ghcr.io/moumouhao12138-sketch/slime-worker:0.0.40
SLIME_BIND_ADDRESS=127.0.0.1
SLIME_PORT=8000
SLIME_DISPATCH_FILE=./dispatch.json
SLIME_WORKER_PROFILE=standard
SLIME_LAB_NETWORK=slime-lab
SLIME_STOP_WORKERS_ON_EXIT=0

# Local Worker image build options used only by `slime build`.
SLIME_PYTHON_IMAGE=python:3.13-slim
SLIME_DOCKER_CLI_IMAGE=docker:29-cli
SLIME_WORKER_BASE_IMAGE=kalilinux/kali-rolling
SLIME_WORKER_DOCKERFILE=Dockerfile
SLIME_KALI_APT_MIRROR=http://http.kali.org/kali
SLIME_KALI_APT_VERIFY_PEER=true
SLIME_INSTALL_NATIVE_AGENTS=true
SLIME_DEEPSEEK_HARNESS_VERSION=0.1.0-rc.7
SLIME_INSTALL_REFERENCE_ASSETS=true
SLIME_INSTALL_CTF_REFERENCE_ASSETS=true

# Optional benchmark control plane. Its token is not copied into Worker prompts.
BENCHMARK_BASE_URL=
BENCHMARK_TOKEN=
BENCHMARK_TIMEOUT=30
BENCHMARK_AUTOMATION_INTERVAL=3

# Optional competition AI Agent API. The AccessKey remains in the API and
# Dispatcher control plane; it is never passed to project Workers.
AGENT_MATCH_BASE_URL=
AGENT_MATCH_ACCESS_KEY=
AGENT_MATCH_TIMEOUT=30
AGENT_MATCH_ENV_POLL_INTERVAL=3
AGENT_MATCH_ENV_READY_TIMEOUT=180

# Competition model gateway guard. When enabled, every Worker base URL must be
# an HTTPS platform gateway URL and each declared upstream URL must be in the
# authorized competition endpoint list documented in docs/COMPETITION.md.
SLIME_COMPETITION_GATEWAY_ONLY=false
SLIME_GATEWAY_FULL_ENDPOINT=false
SLIME_CODEX_UPSTREAM_ENDPOINT=
SLIME_PI_UPSTREAM_ENDPOINT=
SLIME_CLAUDE_UPSTREAM_ENDPOINT=
SLIME_DEEPSEEK_UPSTREAM_ENDPOINT=
