# Model provider used by the default Codex Worker.
SLIME_CODEX_BASE_URL=https://api.example.com/v1
SLIME_CODEX_API_KEY=replace-with-api-key
SLIME_CODEX_MODEL=replace-with-model-name
SLIME_CODEX_REASONING_EFFORT=xhigh

# Optional shared fallback for any Worker with empty adapter-specific values.
SLIME_LLM_BASE_URL=
SLIME_LLM_API_KEY=
SLIME_LLM_MODEL=

# Optional Pi Worker. Enable it in dispatch.json before use.
SLIME_PI_BASE_URL=
SLIME_PI_API_KEY=
SLIME_PI_MODEL=

# Optional Claude Worker. Enable it in dispatch.json before use.
SLIME_CLAUDE_BASE_URL=
SLIME_CLAUDE_API_KEY=
SLIME_CLAUDE_MODEL=

# Compose deployment. Published images are used by default.
SLIME_APP_IMAGE=ghcr.io/moumouhao12138-sketch/slime:0.0.37
SLIME_WORKER_IMAGE=ghcr.io/moumouhao12138-sketch/slime-worker:0.0.37
SLIME_BIND_ADDRESS=127.0.0.1
SLIME_PORT=8000
SLIME_DISPATCH_FILE=./dispatch.json
SLIME_WORKER_PROFILE=standard
SLIME_LAB_NETWORK=slime-lab
SLIME_STOP_WORKERS_ON_EXIT=0

# Local Worker image build options used only by `slime build`.
SLIME_PYTHON_IMAGE=python:3.13-slim
SLIME_DOCKER_CLI_IMAGE=docker:29-cli
SLIME_WORKER_BASE_IMAGE=kalilinux/kali-rolling
SLIME_KALI_APT_MIRROR=http://http.kali.org/kali
SLIME_KALI_APT_VERIFY_PEER=true
SLIME_INSTALL_NATIVE_AGENTS=true
SLIME_INSTALL_REFERENCE_ASSETS=true

# Optional benchmark control plane. Its token is not copied into Worker prompts.
BENCHMARK_BASE_URL=
BENCHMARK_TOKEN=
BENCHMARK_TIMEOUT=30
BENCHMARK_AUTOMATION_INTERVAL=3
