{
  "schema_version": 2,
  "container": {
    "init": true
  },
  "runtime": {
    "execution": "container",
    "prompt_group": "default",
    "interval": 3,
    "max_workers": 8,
    "max_project_workers": 4,
    "max_running_projects": 3,
    "lease_seconds": 15,
    "reason_lease_seconds": 15,
    "heartbeat_interval": 3,
    "reason_batch_size": 2,
    "reason_debounce_seconds": 1.0,
    "max_intent_attempts": 6,
    "intent_failure_backoff_seconds": 30,
    "intent_failure_backoff_max_seconds": 1800,
    "state_heartbeat_interval": 2.0,
    "reason_failure_cooldown_seconds": 5,
    "reason_failure_backoff_max_seconds": 5,
    "reason_failure_pause_threshold": 3,
    "reason_failure_pause_seconds": 60,
    "reason_failure_pause_max_seconds": 300,
    "worker_rejected_cooldown_seconds": 5,
    "intent_worker_cycle_cooldown_seconds": 30,
    "growth_selection_mode": "sma_discrete",
    "growth_exploration_probability": 0.12,
    "growth_exploration_min_probability": 0.03,
    "growth_convergence_selections": 24,
    "growth_random_seed": "slime-sma-v1",
    "worker_healthcheck": "startup_and_task",
    "healthcheck_timeout": 60
  },
  "tasks": {
    "bootstrap": {
      "timeout": 300,
      "conclude_timeout": 90
    },
    "reason": {
      "timeout": 300,
      "max_intents": 8
    },
    "explore": {
      "timeout": 300,
      "conclude_timeout": 90
    }
  },
  "common_env": {},
  "workers": [
    {
      "name": "codex-native",
      "type": "codex",
      "execution": "native-agent",
      "task_types": ["bootstrap", "explore", "reason"],
      "max_running": 8,
      "priority": 0,
      "max_report_items": 30,
      "container_preflight": false,
      "env": {
        "CODEX_MODEL": "${SLIME_CODEX_MODEL|SLIME_LLM_MODEL}",
        "CODEX_BASE_URL": "${SLIME_CODEX_BASE_URL|SLIME_LLM_BASE_URL}",
        "OPENAI_API_KEY": "${SLIME_CODEX_API_KEY|SLIME_LLM_API_KEY}"
      },
      "config_overrides_from_env": {
        "model_reasoning_effort": "SLIME_CODEX_REASONING_EFFORT"
      }
    },
    {
      "name": "pi-native",
      "type": "pi",
      "enabled": true,
      "execution": "native-agent",
      "task_types": ["bootstrap", "explore", "reason"],
      "max_running": 4,
      "priority": 0,
      "max_report_items": 30,
      "env": {
        "PI_MODEL": "${SLIME_PI_MODEL|SLIME_CODEX_MODEL|SLIME_LLM_MODEL}",
        "PI_BASE_URL": "${SLIME_PI_BASE_URL|SLIME_CODEX_BASE_URL|SLIME_LLM_BASE_URL}",
        "PI_API_KEY": "${SLIME_PI_API_KEY|SLIME_CODEX_API_KEY|SLIME_LLM_API_KEY}",
        "PI_PROVIDER_API": "openai-responses"
      }
    },
    {
      "name": "claude-native",
      "enabled": false,
      "type": "claudecode",
      "execution": "native-agent",
      "task_types": ["bootstrap", "explore", "reason"],
      "max_running": 2,
      "priority": 0,
      "max_report_items": 30,
      "env": {
        "ANTHROPIC_MODEL": "${SLIME_CLAUDE_MODEL|SLIME_LLM_MODEL}",
        "ANTHROPIC_BASE_URL": "${SLIME_CLAUDE_BASE_URL|SLIME_LLM_BASE_URL}",
        "ANTHROPIC_AUTH_TOKEN": "${SLIME_CLAUDE_API_KEY|SLIME_LLM_API_KEY}"
      },
      "environment": {
        "CLAUDE_CONFIG_DIR": "/workspace/shared/agent-homes/claude"
      }
    }
  ]
}
